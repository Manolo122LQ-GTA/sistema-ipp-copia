# Plantilla de configuracion - copiar a .env y completar con valores reales
# NUNCA versionar el .env con valores reales.
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=ippbd
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Si usas el MariaDB portable de prueba de esta máquina, cambia a 3307

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_TIMEOUT=30
EMAIL_HOST_USER=
# Contraseña de aplicación de Gmail (16 caracteres, sin espacios)
EMAIL_HOST_PASSWORD=
# Si se omite, se usa la cuenta de EMAIL_HOST_USER
DEFAULT_FROM_EMAIL=

# --- Envío por HTTPS (recomendado si la red bloquea SMTP) ---
# Proveedor: brevo | resend | sendgrid
# Si EMAIL_API_KEY tiene valor, se usa la API HTTPS automáticamente.
EMAIL_API_PROVIDER=brevo
EMAIL_API_KEY=
# Remitente verificado en el proveedor (si se omite, se usa EMAIL_HOST_USER)
EMAIL_API_FROM=
EMAIL_API_TIMEOUT=15

# --- Gmail por HTTPS (sin SMTP) ---
# Despliega el Web App de docs/gmail_webapp.gs y pega aquí la URL /exec y el token.
GMAIL_WEBAPP_URL=
GMAIL_WEBAPP_TOKEN=
GMAIL_WEBAPP_TIMEOUT=30

# Alternativa SMTP si tu proveedor permite el puerto 2525 (el 587 suele estar
# bloqueado). Ejemplo con Brevo:
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=2525
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=tu-login-brevo
# EMAIL_HOST_PASSWORD=tu-clave-smtp-brevo

# Sesión en segundos: debe ser suficiente para leer el correo y usar el enlace
SESSION_COOKIE_AGE=900

# Origenes permitidos para POST (HTTPS/dominio/tunel), separados por comas
CSRF_TRUSTED_ORIGINS=

# Poner a 1 solo si el sistema esta detras de un proxy inverso de confianza
TRUST_PROXY_HEADERS=0

# CORS solo si hay API/cookies desde otro dominio; nunca usar '*'
CORS_ALLOWED_ORIGINS=
